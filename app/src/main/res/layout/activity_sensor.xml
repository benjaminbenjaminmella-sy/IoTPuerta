<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nodo sensor (simulado)" android:textSize="22sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="22.0 °C"
        android:textSize="48sp" android:layout_marginTop="24dp" />

    <com.google.android.material.slider.Slider android:id="@+id/slTemp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:valueFrom="0" android:valueTo="50" android:stepSize="0.5" android:value="22" />

    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swPuerta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Puerta CERRADA" android:layout_marginTop="16dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/swAuto"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Simulación automática (cada 3 s)" android:layout_marginTop="8dp" />

    <TextView android:id="@+id/tvEstado" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" />
</LinearLayout>
