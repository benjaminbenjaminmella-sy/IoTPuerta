<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Único permiso necesario (principio de mínimo privilegio) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="IoT Puerta"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".RoleActivity" android:exported="false" />
        <activity android:name=".SensorActivity" android:exported="false" />
        <activity android:name=".MonitorActivity" android:exported="false" />
    </application>
</manifest>
